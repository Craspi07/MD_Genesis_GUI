{# Shared INI sections for every GENESIS CG control-file template.
   Citations here are short; full rationale is in DECISIONS.md. Every
   comment line uses "#" (GENESIS's .inp parser does not accept ";"). #}
[INPUT]
grotopfile = {{ config.top_file }}   # tutorial 11.1 pro.inp
grocrdfile = {{ config.gro_file }}   # tutorial 11.1 pro.inp
{% if config.restart_file -%}
rstfile    = {{ config.restart_file }}   # tutorial 11.2 step 2.2
{%- endif %}
{% if config.use_position_restraints -%}
groreffile = {{ config.gro_file }}   # GENESIS User Guide 2.0.0 Sec. 13.1: POSI needs reffile/ambreffile/groreffile
{%- endif %}

[OUTPUT]
{% if config.remd_enabled -%}
logfile = {{ config.output_prefix }}_rep{}.log   # GENESIS User Guide 2.0.0 Sec. 5.2/5.6: REMD requires '{}' in per-replica filenames
dcdfile = {{ config.output_prefix }}_rep{}.dcd   # Sec. 5.2/5.6
remfile = {{ config.output_prefix }}_rep{}.rem   # Sec. 5.2: replica-exchange parameter-index log, needed by remd_convert
rstfile = {{ config.output_prefix }}_rep{}.rst   # Sec. 5.2/5.6
# pdbfile omitted under REMD: Sec. 5.2 only confirms logfile/dcdfile/remfile/rstfile need
# '{}' -- whether the ATDYN-only restart-PDB convenience file also needs it is # VERIFY
{% else -%}
pdbfile = {{ config.output_prefix }}.pdb   # tutorial 11.1 pro.inp
dcdfile = {{ config.output_prefix }}.dcd   # tutorial 11.1 pro.inp
rstfile = {{ config.output_prefix }}.rst   # tutorial 11.1 pro.inp
# no logfile keyword: GENESIS writes to stdout, redirected by runner.py
{% endif -%}
{% if config.gamd_enabled -%}
gamdfile = {{ config.output_prefix }}.gamd   # GENESIS User Guide 2.0.0 Sec. 5.3
{% endif -%}

[DYNAMICS]
{% if config.engine == "cgdyn" -%}
integrator     = VVER                       # cgdyn -h ctrl_all: [LEAP,VVER]
{% else -%}
integrator     = VVER_CG                    # atdyn -h ctrl_all: [LEAP,VVER,VVER_CG]; tutorial 11.1 pro.inp
{% endif -%}
nsteps         = {{ config.n_steps }}
timestep       = {{ "%.4f"|format(config.timestep_fs / 1000.0) }}   # ps; from {{ config.timestep_fs }} fs
eneout_period  = {{ config.output_frequency }}
crdout_period  = {{ config.output_frequency }}
rstout_period  = {{ config.output_frequency }}
nbupdate_period = 20                         # tutorial 11.1/11.2/11.3

[CONSTRAINTS]
rigid_bond = NO   # tutorial 11.1 pro.inp

[ENSEMBLE]
ensemble    = {{ config.ensemble }}
{% if config.ensemble == "NVT" -%}
tpcontrol   = LANGEVIN                       # tutorial 11.1/11.2/11.3
{% else -%}
tpcontrol   = LANGEVIN                       # VERIFY: NPT/NPAT/NPgT + LANGEVIN is confirmed for
                                              # generic ATDYN in GENESIS User Guide 2.0.0 Sec. 10.1's
                                              # compatibility table, but that table doesn't cover this
                                              # CG-specific integrator (VVER_CG/cgdyn's VVER) at all --
                                              # confirm against a real cgdyn/atdyn -h ctrl_all before
                                              # trusting an NPT run
{% endif -%}
temperature = {{ config.temperature_k }}
gamma_t     = {{ config.langevin_friction }}
{% if config.ensemble == "NPT" -%}
pressure    = {{ config.pressure_atm }}      # GENESIS User Guide 2.0.0 Sec. 10.1 (target pressure, atm)
gamma_p     = 0.1                            # GENESIS User Guide 2.0.0 Sec. 10.1 (Langevin barostat friction default, ps^-1)
{% endif -%}
{% if config.use_position_restraints -%}

[SELECTION]
group1 = all                                 # GENESIS User Guide 2.0.0 Sec. 12.1; "all" restrains every CG bead

[RESTRAINTS]
nfunctions = 1                               # GENESIS User Guide 2.0.0 Sec. 13.1
function1  = POSI                            # positional restraint; reference coords from [INPUT] groreffile
constant1  = {{ config.position_restraint_force_constant }}
select_index1 = 1                            # POSI takes exactly one group (Sec. 13.1)
{% endif %}
{% if config.remd_enabled -%}

[REMD]
dimension       = 1                          # GENESIS User Guide 2.0.0 Ch. 15, T-REMD example (Sec. 15.4.1)
exchange_period = {{ config.remd_exchange_period }}
type1           = TEMPERATURE
nreplica1       = {{ config.remd_temperatures|length }}
parameters1     = {{ config.remd_temperatures|join(' ') }}
# VERIFY: the User Guide's own regression-test list (Sec. 2.1.4) names test_remd_spdyn and
# test_remd_common, but no atdyn- or cgdyn-specific REMD test -- confirm REMD actually works
# with this app's CG integrator (VVER_CG on atdyn / cgdyn's VVER) before a production run
{% endif -%}
{% if config.gamd_enabled -%}

[GAMD]
gamd          = YES                          # GENESIS User Guide 2.0.0 Sec. 17.1
boost         = YES
boost_type    = POTENTIAL                    # DUAL/DIHEDRAL also need sigma0_dih; its
                                              # documented default wasn't found, so only
                                              # POTENTIAL (needs sigma0_pot only) is offered
thresh_type   = LOWER
update_period = {{ config.gamd_update_period }}
sigma0_pot    = {{ config.gamd_sigma0_pot }}
{% if config.engine != "atdyn" -%}
# VERIFY: GaMD is confirmed by the User Guide's regression tests for atdyn/spdyn
# (test_gamd_atdyn, test_gamd_spdyn) but cgdyn is not in that list -- confirm cgdyn actually
# implements [GAMD] before trusting this on a cgdyn run
{% endif -%}
{% endif -%}
