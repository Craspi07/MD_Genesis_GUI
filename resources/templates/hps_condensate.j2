{# HPS condensate/slab control file: N copies in an elongated box.
   [ENERGY] confirmed against tutorial 11.4 (FUS, multi-chain step,
   fus_120.inp); box example also from that step (180 x 180 x 1800).
   See DECISIONS.md. #}
{% include "_common_sections.j2" %}

[ENERGY]
forcefield            = RESIDCG   # tutorial 11.4 fus_120.inp
electrostatic         = CUTOFF    # tutorial 11.4 fus_120.inp
cg_cutoffdist_ele     = 52.0      # tutorial 11.4 fus_120.inp
cg_cutoffdist_126     = 39.0      # tutorial 11.4 fus_120.inp
cg_pairlistdist_ele   = 57.0      # tutorial 11.4 fus_120.inp
cg_pairlistdist_126   = 44.0      # tutorial 11.4 fus_120.inp
cg_sol_ionic_strength = 0.15      # tutorial 11.4 fus_120.inp
cg_IDR_HPS_epsilon    = 0.2       # tutorial 11.4 fus_120.inp

[BOUNDARY]
type       = PBC   # tutorial 11.4 fus_120.inp
box_size_x = {{ config.box_x }}   # tutorial example: 180.0 x 180.0 x 1800.0 slab
box_size_y = {{ config.box_y }}
box_size_z = {{ config.box_z }}
