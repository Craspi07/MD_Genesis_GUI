{# HPS condensate / slab control file: N copies in an elongated box.
   # VERIFY throughout (see _common_sections.j2). The N-copy replication
   itself is done locally by app/cgtool.py (no genesis_cg_tool flag for it
   was found — see DECISIONS.md), so cgdyn is used here unconditionally
   since multi-chain systems are its intended use case. #}
{% include "_common_sections.j2" %}

[ENERGY]
forcefield       = AICG2+   # VERIFY: see hps_single.j2 note on cg_IDR_HPS_region
electrostatic    = DEBYE_HUCKEL   # VERIFY
cg_pairlistdist  = 20.0           # VERIFY

[BOUNDARY]
type    = PBC   # VERIFY: a slab/condensate box needs periodic boundaries
box_size_x = {{ config.box_x }}
box_size_y = {{ config.box_y }}
box_size_z = {{ config.box_z }}
