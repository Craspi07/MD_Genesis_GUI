{# Shared [REMD]/[GAMD] sections (Roadmap Phase 4), included by both
   _common_sections.j2 (CG models) and all_atom_charmm.j2 -- the content
   here is identical for both: generic GENESIS User Guide keywords with
   no CG- or AA-specific citations, so it's factored out once rather
   than duplicated. See DECISIONS.md. #}
{% if config.remd_enabled -%}

[REMD]
dimension       = 1                          # GENESIS User Guide 2.0.0 Ch. 15, T-REMD example (Sec. 15.4.1)
exchange_period = {{ config.remd_exchange_period }}
type1           = TEMPERATURE
nreplica1       = {{ config.remd_temperatures|length }}
parameters1     = {{ config.remd_temperatures|join(' ') }}
# VERIFY: the User Guide's own regression-test list (Sec. 2.1.4) names test_remd_spdyn and
# test_remd_common, but no atdyn- or cgdyn-specific REMD test -- confirm REMD actually works
# with this app's integrator (VVER_CG/cgdyn's VVER for CG, plain VVER for all-atom) before a
# production run
{% endif -%}
{% if config.gamd_enabled -%}

[GAMD]
gamd          = YES                          # GENESIS User Guide 2.0.0 Sec. 17.1
boost         = YES
boost_type    = POTENTIAL                    # DUAL/DIHEDRAL also need sigma0_dih; its
                                              # documented default wasn't found, so only
                                              # POTENTIAL (needs sigma0_pot only) is offered
thresh_type   = LOWER
update_period = {{ config.gamd_update_period }}
sigma0_pot    = {{ config.gamd_sigma0_pot }}
{% if config.engine != "atdyn" -%}
# VERIFY: GaMD is confirmed by the User Guide's regression tests for atdyn/spdyn
# (test_gamd_atdyn, test_gamd_spdyn) but cgdyn is not in that list -- confirm cgdyn actually
# implements [GAMD] before trusting this on a cgdyn run
{% endif -%}
{% endif -%}
